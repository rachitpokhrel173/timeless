# Public URL of the site (canonical URLs, sitemap, Open Graph). Defaults to the production domain.
NEXT_PUBLIC_SITE_URL=https://timelesstieevents.com.np

# Verification codes from Google Search Console and Bing Webmaster Tools (content="..." value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Where website inquiries are sent (JSON POST). Any endpoint works: the future admin API,
# a Zapier/Make webhook, Google Apps Script, etc. Without it, production shows visitors a
# "please call or WhatsApp" message instead of pretending the inquiry was received.
INQUIRY_WEBHOOK_URL=
# Optional — sent as "Authorization: Bearer <secret>"
INQUIRY_WEBHOOK_SECRET=
