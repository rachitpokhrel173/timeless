# ── Site ─────────────────────────────────────────────────────────────
# Public URL (canonical URLs, sitemap, Open Graph, email links)
NEXT_PUBLIC_SITE_URL=https://www.timelesstieevents.com.np

# ── Supabase (Project Settings → API Keys / Database) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Browser-safe key (all access is subject to Row Level Security)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use this name instead of the publishable key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses RLS. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# ── Email (Resend) — every email comes from the no-reply address, with no reply-to ─────────
# Quotations, receipts and reminders are sent by the app. Leave empty to only log them in the outbox.
# Supabase invite and password-reset emails use the same key as their SMTP password
# (supabase/config.toml locally; Authentication → Emails → SMTP Settings on the hosted project).
RESEND_API_KEY=
# The no-reply address on the domain verified in Resend
EMAIL_FROM=Timeless Ties Events & Decor <noreply@timelesstieevents.com.np>

# ── Optional integrations ────────────────────────────────────────────
# Protects /api/cron/automations (Vercel Cron sends it automatically)
CRON_SECRET=
# Search Console / Bing verification (content="…" value only)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Forward website inquiries to another system as JSON (optional; they're always saved in Supabase)
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
