# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (dev database, uploads) and scratch output
/.data
/.drizzle-scratch

# Supabase folder (migrations, seed, config, templates) is kept local only — never committed
/supabase/

# logs
logs
*.log

# Local docs and AI-assistant instructions — kept on this machine, not in GitHub
/AGENTS.md
/CLAUDE.md
/README.md
