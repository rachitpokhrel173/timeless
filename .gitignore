# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real credentials
.env
.env.*
!.env.example
*.secret
*.key
*.pem

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data (dev database, uploads) and scratch output
/.data
/.drizzle-scratch

# Supabase: local CLI state and secrets stay out of Git; the SQL and config needed to deploy
# (migrations, seed, config.toml, email templates) are tracked. None of them may hold real keys —
# config.toml reads secrets with env(...).
/supabase/*
!/supabase/.gitignore
!/supabase/config.toml
!/supabase/seed.sql
!/supabase/migrations/
!/supabase/templates/
/supabase/.branches/
/supabase/.temp/
/supabase/.env
/supabase/.env.*
/supabase/*.local.*

# logs
logs
*.log
